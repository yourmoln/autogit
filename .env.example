# ---------------------------------------------------------------------------
# AutoGit runtime configuration (all values are optional)
# ---------------------------------------------------------------------------

# Where AutoGit stores its database, workspaces and logs.
# Defaults to ~/.autogit
# AUTOGIT_HOME=C:\Users\me\.autogit

# Master key used to encrypt Git tokens at rest (32+ chars).
# When omitted AutoGit generates ~/.autogit/secret.key with restrictive rights.
# AUTOGIT_SECRET_KEY=

# HTTP port for the API + built web UI
AUTOGIT_PORT=4711

# Bind address. Keep 127.0.0.1 unless you know what you are doing.
AUTOGIT_HOST=127.0.0.1

# Directory of the built web app that the server should serve (production).
# AUTOGIT_WEB_DIST=./apps/web/dist

# Polling cadence of the orchestrator, in seconds.
AUTOGIT_POLL_SECONDS=45

# How many Codex tasks may run in parallel across all repositories.
AUTOGIT_MAX_CONCURRENT=2

# Override the Codex home directory (defaults to ~/.codex)
# CODEX_HOME=C:\Users\me\.codex

# Explicit path to the Codex CLI binary. Falls back to PATH lookup.
# AUTOGIT_CODEX_PATH=C:\Users\me\AppData\Roaming\npm\codex.cmd

# Log level: trace | debug | info | warn | error
AUTOGIT_LOG_LEVEL=info
