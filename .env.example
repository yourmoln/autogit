# ---------------------------------------------------------------------------
# AutoGit runtime configuration (all values are optional)
# ---------------------------------------------------------------------------

# Where AutoGit stores its database, workspaces and logs.
# Defaults to ~/.autogit
# AUTOGIT_HOME=C:\Users\me\.autogit

# Master key used to encrypt Git tokens at rest (32+ chars).
# When omitted AutoGit generates ~/.autogit/secret.key with restrictive rights.
# AUTOGIT_SECRET_KEY=

# HTTP port for the API + built web UI
AUTOGIT_PORT=4711

# Bind address. Keep 127.0.0.1 unless you know what you are doing.
AUTOGIT_HOST=127.0.0.1

# Extra origins the realtime WebSocket upgrade and every non-safe /api method
# (POST / PUT / PATCH / DELETE) accept, comma separated. Both already require an
# Origin matching the host the request arrived on; list entries here when a
# reverse proxy rewrites Host (for example
# AUTOGIT_ALLOWED_ORIGINS=https://autogit.example.com) or when the console runs
# on another machine. This is the only way to allow extra origins in production.
# Entries are matched as complete origins, so https://autogit.example.com does
# not also accept http://autogit.example.com — write the scheme (recommended).
# A bare host[:port] entry keeps the older host-only match.
# AUTOGIT_ALLOWED_ORIGINS=https://autogit.example.com

# Origins of the local Vite dev console. Defaults to http://localhost:5173 and
# http://127.0.0.1:5173, which is what lets the Vite dev server reach the
# backend through its Host-rewriting proxy. Set it when Vite bound another port
# because 5173 was taken. Only honored in development mode (NODE_ENV is not
# 'production'); production ignores this variable, use AUTOGIT_ALLOWED_ORIGINS.
# The scheme is part of the comparison, so a Vite dev server served over HTTPS
# has to be listed as https://localhost:5173.
# AUTOGIT_DEV_ORIGINS=http://localhost:5174

# Optional. `pnpm start` runs the compiled bundle (dist/index.js) and defaults
# to production when this is unset, while `pnpm dev` runs the TypeScript source
# and stays in development. Set it explicitly to override the default.
# NODE_ENV=production

# Directory of the built web app that the server should serve (production).
# AUTOGIT_WEB_DIST=./apps/web/dist

# Polling cadence of the orchestrator, in seconds.
AUTOGIT_POLL_SECONDS=45

# How many Codex tasks may run in parallel across all repositories.
AUTOGIT_MAX_CONCURRENT=2

# How many tasks one repository may run at the same time. Each task works in
# its own clone under ~/.autogit/workspaces/tasks, so raising this is safe for
# branches; keep it low while repositories are large.
AUTOGIT_MAX_CONCURRENT_PER_REPO=1

# Override the Codex home directory (defaults to ~/.codex)
# CODEX_HOME=C:\Users\me\.codex

# Explicit path to the Codex CLI binary. Falls back to PATH lookup.
# AUTOGIT_CODEX_PATH=C:\Users\me\AppData\Roaming\npm\codex.cmd

# Log level: trace | debug | info | warn | error
AUTOGIT_LOG_LEVEL=info
